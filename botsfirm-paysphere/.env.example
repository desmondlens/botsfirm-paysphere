# =============================================================================
# Botsfirm PaySphere — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Botsfirm PaySphere
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
PORT=5000

# -----------------------------------------------------------------------------
# Supabase (Database + Auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Direct PostgreSQL connection (for migrations / server-side queries)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Frontend (must be prefixed REACT_APP_ to be exposed to the React bundle)
# -----------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
REACT_APP_API_URL=http://localhost:5000
REACT_APP_APP_NAME=Botsfirm PaySphere

# -----------------------------------------------------------------------------
# Authentication & Session
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=no-reply@botsfirm.co.bw
EMAIL_FROM_NAME=Botsfirm PaySphere
EMAIL_SUPPORT_ADDRESS=support@botsfirm.co.bw

# -----------------------------------------------------------------------------
# Trial System
# -----------------------------------------------------------------------------
TRIAL_DURATION_DAYS=7
TRIAL_MAX_EMPLOYEES=5
TRIAL_MAX_PAYROLL_RUNS=1
TRIAL_DATA_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Botswana Statutory (2025/2026) — fallback defaults; live values in DB
# -----------------------------------------------------------------------------
PAYE_TAX_YEAR=2025-2026
CITIZEN_TAX_FREE_THRESHOLD=4000
NON_CITIZEN_TAX_FREE_THRESHOLD=0
TOP_MARGINAL_RATE=0.265
SDL_RATE=0.002
SDL_TURNOVER_THRESHOLD=1000000
MINIMUM_WAGE_PER_HOUR=9.06
OVERTIME_MULTIPLIER=1.5
OVERTIME_WEEKLY_CAP_HOURS=14

# -----------------------------------------------------------------------------
# File Storage / Generated Documents
# -----------------------------------------------------------------------------
PDF_OUTPUT_DIR=./generated/payslips
EXCEL_OUTPUT_DIR=./generated/exports
TEMP_DIR=./tmp

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
ENCRYPTION_KEY=replace-with-32-byte-hex-string

# -----------------------------------------------------------------------------
# Logging / Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_RETENTION_YEARS=5

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
VERCEL_PROJECT_ID=
RAILWAY_PROJECT_ID=
